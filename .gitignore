# ---- 便携工具链：不要提交 git 本体（解压后上百 MB）----
.tools/

# ---- 密钥与凭证：绝不提交 ----
.env
.env.*
!.env.example
*.key
*.pem
*.p12
credentials.json

# ---- 生成的媒体素材：体积大、可复现，按需再决定是否入库 ----
out/
output/
renders/
assets/generated/
assets/refs/
assets/keyframes/
assets/videos/
assets/subs/
assets/frames/
*.mp4
*.mov
*.webm
*.wav

# ---- SQLite 生产库：可变二进制状态，不进 git ----
# schema 与价目已由 db/schema.sql + db/init_db.py 保证可重建
# 需要备份数据时跑 python db/export.py，导出的是文本，可以进 git
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.db.bak-*

# ---- 私有 Clash 内核产物：含订阅节点凭据，绝不进 git ----
.tools/clash-priv/

# ---- DSH 运行时产物 ----
*.tmp
~$*
Thumbs.db
.DS_Store

# ---- 第三方技能包：内容不进 git，只留下出处清单 ----
# skills/techniques/ 下的包来自别处：12 个是 OpenMontage（AGPL-3.0）、
# 2 个是 ai-mandrama-skills（MIT）。本仓库是公开的，转发 AGPL 内容会带来
# 许可义务，所以只保留我们自己的出处清单 _provenance.json。
# 装回来一条命令： python tools\install_skill.py --restore
skills/techniques/*/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- Node ----
node_modules/

