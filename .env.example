# 环境变量模板 —— 复制成 .env 后填真值
#
#   Copy-Item .env.example .env
#
# .env 已被 .gitignore 挡住，不会进 git，也不会被推到 GitHub。
# 本文件（.env.example）不含任何真实密钥，可以安全提交。
#
# 为什么用文件而不是 setx：DSH 宿主进程在设环境变量之前就启动了，
# setx 的结果它看不见。文件是本机唯一可靠的传递方式。
# 详见 pipeline/common.py 的 load_env()。

# ---------------------------------------------------------------- 火山方舟（Ark）
# 图片（Seedream 定妆照/三视图/首帧图）与视频（Seedance）都要它。
# 控制台：https://console.volcengine.com/ark → API Key 管理 → 创建
# ⚠️ 还要在「开通管理」里开通对应模型的调用权限，否则 key 对了也会报权限错。
ARK_API_KEY=

# 可选：覆盖默认模型/端点。不填就用代码里的默认值。
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
# ARK_VIDEO_MODEL=doubao-seedance-2-5-260628

# ---------------------------------------------------------------- 文本模型（剧本/实体/分镜）
# 第 1/2/5/6 阶段要一个 OpenAI 兼容的文本模型。
# LLM_MODEL **必填且没有默认值**——故意的，避免猜错模型 ID 把调用打到不存在的模型上。
#
# 最省事：用方舟自己的文本模型。去控制台「在线推理」创建一个推理接入点，
# 把接入点的 ID（形如 ep-2026xxxx-xxxxx）填到下面。
# LLM_API_KEY 不填会自动回退用 ARK_API_KEY。
LLM_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---------------------------------------------------------------- 其它（一般不用动）
# 素材根目录，默认 <仓库>/assets
# DSH_ASSETS_ROOT=
# 数据库路径，默认 <仓库>/data/drama.db
# DSH_DRAMA_DB=

# ---------------------------------------------------------------- 花费可见性（默认不拦）
#
# 各阶段在提交付费任务前会打印「本集累计已花 / 本次预估 / 合计」。
# **默认只报数、不拦人**（第一次做难免花冤枉钱，不要被数字挡住）。
#
# 想让它替你拦，才设这一行：超过该金额就直接拒绝生成。
# DSH_EPISODE_BUDGET=150

